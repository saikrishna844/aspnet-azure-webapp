<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sai Krishna Vempati — Azure Cloud and DevOps Engineer specializing in Terraform, CI/CD, automation and cloud operations." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@500;600;700;800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header" id="siteHeader">
        <div class="container nav-wrap">
            <a class="brand" href="#home" aria-label="Sai Krishna home"><span>SK</span><strong>Sai Krishna</strong></a>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
            <nav class="site-nav" id="siteNav" aria-label="Main navigation">
                <a href="#about">About</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#certifications">Certifications</a>
                <a class="nav-cta" href="#contact">Let’s connect</a>
            </nav>
        </div>
    </header>

    <main role="main">@RenderBody()</main>

    <footer class="site-footer">
        <div class="container footer-wrap">
            <p>© @DateTime.Now.Year Sai Krishna Vempati</p>
            <p>Built with ASP.NET Core • Deployed on Azure through GitHub Actions</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

