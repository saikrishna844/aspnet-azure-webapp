        </div>
        <div class="cert-grid">
            <article class="cert-card reveal"><span class="cert-code">AZ-104</span><div><p>Microsoft Certified</p><h3>Azure Administrator Associate</h3></div></article>
            <article class="cert-card reveal delay-1"><span class="cert-code">AZ-400</span><div><p>Microsoft Certified</p><h3>DevOps Engineer Expert</h3></div></article>
            <article class="cert-card reveal delay-2"><span class="cert-code">ITIL</span><div><p>PeopleCert</p><h3>ITIL 4 Foundation</h3></div></article>
